// ProductName "BG3 VR" lets tools/deploy.ps1 tell this proxy apart from another mod's version.dll.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,0,1,0
 PRODUCTVERSION 0,0,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "BG3 VR loader (version.dll proxy)"
            VALUE "FileVersion", "0.0.1"
            VALUE "OriginalFilename", "version.dll"
            VALUE "ProductName", "BG3 VR"
            VALUE "ProductVersion", "0.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
